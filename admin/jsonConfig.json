{
    "i18n": true,
    "type": "panel",
    "items": {
        "_headerGateway": {
            "type": "header",
            "text": "WL-433 gateway",
            "size": 2,
            "newLine": true
        },
        "_introText": {
            "type": "staticText",
            "text": "The gateway is controlled locally via the Tuya LAN protocol. Device ID and local key can be read from the debug log of the MiBoxer app (see README).",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "_guideLink": {
            "type": "staticLink",
            "text": "Guide: how to get the device ID and local key (German, for Android, iPhone and iPad)",
            "href": "https://github.com/ssbingo/ioBroker.miboxer-wl433/blob/main/doc/Anleitung_Geraete-ID_und_Local-Key_auslesen.md",
            "target": "_blank",
            "button": true,
            "variant": "outlined",
            "icon": "info",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "deviceId": {
            "type": "text",
            "label": "Device ID",
            "help": "Tuya device ID of the WL-433 gateway",
            "newLine": true,
            "trim": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "localKey": {
            "type": "password",
            "label": "Local key",
            "help": "16 characters, changes whenever the gateway is paired again",
            "repeat": false,
            "visible": true,
            "maxLength": 16,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "ip": {
            "type": "text",
            "label": "IP address of the gateway",
            "help": "Leave empty to find the gateway automatically in the local network",
            "newLine": true,
            "trim": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "protocolVersion": {
            "type": "select",
            "label": "Tuya protocol version",
            "help": "The WL-433 uses 3.3",
            "options": [
                {
                    "label": "3.1",
                    "value": "3.1"
                },
                {
                    "label": "3.3",
                    "value": "3.3"
                },
                {
                    "label": "3.4",
                    "value": "3.4"
                },
                {
                    "label": "3.5",
                    "value": "3.5"
                }
            ],
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_discover": {
            "type": "sendTo",
            "label": "Search gateway in the local network",
            "command": "discover",
            "jsonData": "{\"deviceId\": \"${data.deviceId}\"}",
            "useNative": true,
            "showProcess": true,
            "timeout": 20000,
            "variant": "outlined",
            "result": {
                "found": "Gateway found at %s (protocol %s). IP address and protocol version have been entered, please save the settings.",
                "list": "Tuya devices in the local network: %s"
            },
            "error": {
                "noneFound": "No Tuya device announced itself in the local network. Is the gateway online and in the same network segment as ioBroker?",
                "notFoundOthers": "Gateway %s was not found. Other Tuya devices: %s"
            },
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_discoverHint": {
            "type": "staticText",
            "text": "The search needs a running adapter instance and takes up to 12 seconds. Without a device ID all Tuya devices found are listed.",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "_headerConnection": {
            "type": "header",
            "text": "Connection",
            "size": 2,
            "newLine": true
        },
        "reconnectInterval": {
            "type": "number",
            "label": "Reconnect delay",
            "help": "Seconds until a lost or failed connection is retried",
            "min": 5,
            "max": 3600,
            "unit": "s",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "pollInterval": {
            "type": "number",
            "label": "Status refresh interval",
            "help": "Seconds between full status requests, 0 = only use the updates pushed by the gateway",
            "min": 0,
            "max": 3600,
            "unit": "s",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_singleConnectionHint": {
            "type": "staticText",
            "text": "Tuya devices accept only one local connection. Close the MiBoxer app on phones in the same network and do not control the gateway with other local integrations at the same time.",
            "newLine": true,
            "style": {
                "fontWeight": "bold"
            },
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        }
    }
}
